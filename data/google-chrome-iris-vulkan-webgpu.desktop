[Desktop Entry]
Version=1.0
Type=Application
Name=Google Chrome (Iris Vulkan/WebGPU experiment)
Comment=Experimental Vulkan and ANGLE profile; video may fall back to software decoding
Exec=iris-vaapi-browser --browser=chrome --vulkan-webgpu -- %U
TryExec=iris-vaapi-browser
Terminal=false
Icon=google-chrome
Categories=Network;WebBrowser;
StartupNotify=true
StartupWMClass=google-chrome
