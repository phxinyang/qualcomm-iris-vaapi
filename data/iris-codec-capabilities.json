{
  "schema_version": 2,
  "target": "Qualcomm Iris stateful V4L2 on ARM64 (SM8550, decode-order kernel module)",
  "policy": {
    "production_va_requires_exact_evidence": true,
    "unknown_codec_action": "software-fallback",
    "evidence": "TEST-RESULTS.md (Phase 3, 5, 7 sections)"
  },
  "codecs": [
    {
      "codec": "h264",
      "production": "supported",
      "va_profiles": [
        "H264ConstrainedBaseline",
        "H264Main",
        "H264High"
      ],
      "v4l2_output_formats": [
        "H264"
      ],
      "capture_formats": [
        "NV12"
      ],
      "fallback": "software",
      "rejected": [
        "MVC/multiview",
        "interlaced",
        "non-8-bit or non-4:2:0"
      ],
      "experimental": []
    },
    {
      "codec": "hevc",
      "production": "supported",
      "va_profiles": [
        "HEVCMain",
        "HEVCMain10"
      ],
      "v4l2_output_formats": [
        "HEVC"
      ],
      "capture_formats": [
        "NV12",
        "P010"
      ],
      "fallback": "software",
      "rejected": [
        "long-term references (generated parameter sets cannot describe them)",
        "interlaced",
        "12-bit"
      ],
      "experimental": []
    },
    {
      "codec": "vp9",
      "production": "supported",
      "va_profiles": [
        "VP9Profile0",
        "VP9Profile2"
      ],
      "v4l2_output_formats": [
        "VP9"
      ],
      "capture_formats": [
        "NV12",
        "P010"
      ],
      "fallback": "software",
      "rejected": [
        "show_existing_frame through VA",
        "12-bit",
        "RGB"
      ],
      "experimental": []
    },
    {
      "codec": "av1",
      "production": "fallback",
      "va_profiles": [],
      "v4l2_output_formats": [
        "AV1"
      ],
      "capture_formats": [
        "NV12"
      ],
      "fallback": "native-v4l2-or-software",
      "rejected": [
        "hidden (show_frame=0) pictures: the firmware returns no CAPTURE for them and VA has no show_existing_frame call",
        "film grain",
        "large-scale tile"
      ],
      "experimental": [
        "V4L2_VA_EXPERIMENTAL_PROFILES=1 advertises AV1Profile0; the OBU rebuild is bit-exact under test/av1-obu-roundtrip.sh but VA clients time out on hidden frames"
      ]
    }
  ]
}
