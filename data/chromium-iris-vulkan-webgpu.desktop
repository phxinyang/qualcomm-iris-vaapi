[Desktop Entry]
Version=1.0
Type=Application
Name=Chromium (Iris Vulkan/WebGPU experiment)
Comment=Experimental Vulkan and ANGLE profile; video may fall back to software decoding
Exec=iris-vaapi-browser --browser=chromium --vulkan-webgpu -- %U
TryExec=chromium-browser
Terminal=false
Icon=chromium-browser
Categories=Network;WebBrowser;
StartupNotify=true
StartupWMClass=Chromium-browser
