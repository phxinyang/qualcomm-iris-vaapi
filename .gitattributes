*.patch -whitespace
*.diff -whitespace

# The source archive is a buildable artifact, not a repository clone. VCS and
# CI metadata, agent instructions and experiment records stay in the repo;
# git archive honours export-ignore while the working tree keeps the files.
# Distribution packaging stays in the archive: the shipped spec's %check runs
# test/iris-packaging-check.sh, which reads all three formats from the unpacked
# tree. The archive self-check needs a git checkout and skips there; its
# exclusions are asserted in test/iris-make-dist-check.sh from a fixture.
/.gitattributes export-ignore
/.gitignore export-ignore
/.github/ export-ignore
/AGENTS.md export-ignore
/docs/experiments/ export-ignore
